{
  "rules": {
    ".read": false,
    ".write": false,
    "economyRooms": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[0-9]{6}$/)",
        ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() == auth.uid) || data.child('hostId').val() == auth.uid)",
        "hostId": {
          ".write": "auth != null && !data.exists() && newData.val() == auth.uid",
          ".validate": "newData.isString()"
        },
        "gameId": {
          ".write": "auth != null && (data.parent().child('hostId').val() == auth.uid || newData.parent().child('hostId').val() == auth.uid)",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "status": {
          ".write": "auth != null && (data.parent().child('hostId').val() == auth.uid || newData.parent().child('hostId').val() == auth.uid)",
          ".validate": "newData.val() == 'lobby' || newData.val() == 'turn' || newData.val() == 'reveal' || newData.val() == 'final'"
        },
        "round": {
          ".write": "auth != null && (data.parent().child('hostId').val() == auth.uid || newData.parent().child('hostId').val() == auth.uid)",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
        },
        "eventOrder": {
          ".write": "auth != null && (data.parent().child('hostId').val() == auth.uid || newData.parent().child('hostId').val() == auth.uid)"
        },
        "results": {
          ".write": "auth != null && data.parent().child('hostId').val() == auth.uid"
        },
        "submittedCount": {
          ".write": "auth != null && data.parent().child('hostId').val() == auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
        },
        "updatedAt": {
          ".write": "auth != null && (data.parent().child('hostId').val() == auth.uid || newData.parent().child('hostId').val() == auth.uid)"
        },
        "createdAt": {
          ".write": "auth != null && !data.exists()"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid == $uid || root.child('economyRooms').child($code).child('hostId').val() == auth.uid)",
            "nickname": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "connected": {
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "economyChoices": {
      "$code": {
        "$round": {
          ".read": "auth != null && root.child('economyRooms').child($code).child('hostId').val() == auth.uid",
          ".write": "auth != null && root.child('economyRooms').child($code).child('hostId').val() == auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('economyRooms').child($code).child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['strategyId', 'submittedAt']) && newData.child('strategyId').isString() && newData.child('strategyId').val().length <= 30"
          }
        }
      }
    },
    "seedRanking": {
      "runs": {
        ".read": "auth != null",
        ".indexOn": [
          "score"
        ],
        "$runId": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() == auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() == auth.uid))",
          ".validate": "newData.hasChildren(['uid', 'name', 'score', 'cycle', 'stage', 'kills', 'time', 'at']) && newData.child('kills').val() <= (newData.child('cycle').val() + 1) * 160 && newData.child('score').val() <= (newData.child('kills').val() + 12) * 50 * (1 + newData.child('cycle').val() / 2) && newData.child('time').val() >= newData.child('cycle').val() * 15 && newData.child('time').val() >= newData.child('kills').val() / 6 && newData.child('score').val() >= newData.child('kills').val() * 8",
          "uid": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000000"
          },
          "cycle": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "stage": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
          },
          "kills": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "time": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "builds": {
        ".read": "auth != null",
        "$runId": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() == auth.uid && root.child('seedRanking').child('runs').child($runId).child('uid').val() == auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() == auth.uid))",
          ".validate": "newData.hasChildren(['uid', 'laws', 'forms', 'relic', 'wardens', 'austins'])",
          "uid": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "laws": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "forms": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "relic": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "wardens": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "austins": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "season11": {
        "runs": {
          ".read": "auth != null",
          ".indexOn": [
            "score"
          ],
          "$runId": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && ((!data.exists() && newData.child('uid').val() == auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() == auth.uid))",
            ".validate": "newData.hasChildren(['uid', 'name', 'score', 'cycle', 'stage', 'kills', 'time', 'at']) && newData.child('kills').val() <= (newData.child('cycle').val() + 1) * 180 && newData.child('score').val() <= (newData.child('kills').val() + 12) * 50 * (1 + newData.child('cycle').val() / 2) && newData.child('time').val() >= newData.child('cycle').val() * 15 && newData.child('time').val() >= newData.child('kills').val() / 6 && newData.child('score').val() >= newData.child('kills').val() * 8",
            "uid": {
              ".validate": "newData.isString() && newData.val() == auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000000"
            },
            "cycle": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "stage": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
            },
            "kills": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
            },
            "time": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
            },
            "act": {
              ".validate": "newData.isNumber() && (newData.val() == 1 || newData.val() == 2)"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "builds": {
          ".read": "auth != null",
          "$runId": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && ((!data.exists() && newData.child('uid').val() == auth.uid && root.child('seedRanking').child('season11').child('runs').child($runId).child('uid').val() == auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() == auth.uid))",
            ".validate": "newData.hasChildren(['uid', 'laws', 'forms', 'relic', 'wardens', 'austins'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() == auth.uid"
            },
            "laws": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "forms": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "relic": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "wardens": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "austins": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "season12": {
        "runs": {
          ".read": "auth != null",
          ".indexOn": [
            "score"
          ],
          "$runId": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && ((!data.exists() && newData.child('uid').val() == auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() == auth.uid))",
            ".validate": "newData.hasChildren(['uid', 'name', 'score', 'cycle', 'stage', 'kills', 'time', 'at']) && newData.child('kills').val() <= (newData.child('cycle').val() + 1) * 180 && newData.child('score').val() <= (newData.child('kills').val() + 12) * 50 * (1 + newData.child('cycle').val() / 2) && newData.child('time').val() >= newData.child('cycle').val() * 15 && newData.child('time').val() >= newData.child('kills').val() / 6 && newData.child('score').val() >= newData.child('kills').val() * 8 && newData.child('cycle').val() <= 49",
            "uid": {
              ".validate": "newData.isString() && newData.val() == auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000000"
            },
            "cycle": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "stage": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
            },
            "kills": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
            },
            "time": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
            },
            "act": {
              ".validate": "newData.isNumber() && (newData.val() == 1 || newData.val() == 2)"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "done": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "builds": {
          ".read": "auth != null",
          "$runId": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && ((!data.exists() && newData.child('uid').val() == auth.uid && root.child('seedRanking').child('season12').child('runs').child($runId).child('uid').val() == auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() == auth.uid))",
            ".validate": "newData.hasChildren(['uid', 'laws', 'forms', 'relic', 'wardens', 'austins'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() == auth.uid"
            },
            "laws": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "forms": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "relic": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "wardens": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "austins": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "seedUsers": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "save": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['version', 'revision', 'updatedAt', 'discoveries', 'garden', 'shop', 'checkpoints', 'settings', 'player', 'account'])",
          "version": {
            ".validate": "newData.isNumber() && newData.val() == 1"
          },
          "revision": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000 && (!data.exists() || newData.val() >= data.val())"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
          },
          "discoveries": {
            ".validate": "newData.hasChildren()"
          },
          "garden": {
            ".validate": "newData.hasChildren()"
          },
          "shop": {
            ".validate": "newData.hasChildren() && newData.child('coins').isNumber() && newData.child('coins').val() >= 0 && newData.child('coins').val() <= 9999999"
          },
          "checkpoints": {
            ".validate": "newData.hasChildren()"
          },
          "settings": {
            ".validate": "newData.hasChildren() && newData.child('quality').isNumber() && newData.child('quality').val() >= 0 && newData.child('quality').val() <= 2"
          },
          "player": {
            ".validate": "newData.hasChildren() && newData.child('name').isString() && newData.child('name').val().length <= 16"
          },
          "account": {
            ".validate": "newData.hasChildren()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "seedBetaApplicants": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['email', 'displayName', 'android', 'consentVersion', 'appliedAt', 'status', 'source']) && newData.child('email').isString() && newData.child('email').val().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/) && newData.child('email').val().length <= 254 && (auth.token.firebase.sign_in_provider == 'anonymous' || newData.child('email').val() == auth.token.email) && newData.child('displayName').isString() && newData.child('displayName').val().length <= 80 && newData.child('android').val() == true && newData.child('consentVersion').isString() && newData.child('appliedAt').isNumber() && newData.child('appliedAt').val() <= now && newData.child('status').val() == 'pending' && newData.child('source').val() == 'public-web'",
        "$other": {
          ".validate": false
        }
      }
    },
    "seedUserRewards": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false,
        "$grantId": {
          ".validate": "newData.hasChildren(['label', 'createdAt', 'rewards']) && newData.child('label').isString() && newData.child('label').val().length <= 80 && newData.child('createdAt').isNumber() && newData.child('rewards').hasChildren()"
        }
      }
    },
    "seedPerformance": {
      "sessions": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          "$sessionId": {
            ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider != 'anonymous'",
            ".validate": "newData.hasChildren(['v', 'at', 'version', 'device', 'p95', 'avg', 'r']) && $sessionId.length <= 40",
            "v": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "version": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "device": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "p95": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
            },
            "avg": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "r": {
              ".validate": "newData.isString() && newData.val().length <= 60000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
